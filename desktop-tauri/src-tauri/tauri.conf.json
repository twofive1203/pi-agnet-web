{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnailPiPet Tauri Preview",
  "version": "0.1.0",
  "identifier": "com.twofive.snail-pi-pet.tauri-preview",
  "build": {
    "beforeDevCommand": "node ../scripts/build-desktop-tauri.mjs",
    "beforeBuildCommand": "node ../scripts/build-desktop-tauri.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "pet",
        "title": "Snail Pi Pet — Tauri Preview",
        "width": 197,
        "height": 235,
        "minWidth": 164,
        "minHeight": 196,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": false,
        "focus": false,
        "shadow": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "publisher": "TwoFive",
    "copyright": "Copyright TwoFive. Preview artifact; not the default SnailPiPet product.",
    "category": "Utility",
    "shortDescription": "Isolated Tauri Preview of the Snail Pi desktop pet.",
    "longDescription": "Attach-only Windows Preview that connects to an already running spi service. It does not replace Electron SnailPiPet, does not start or stop spi, and uses a separate application identity, install directory, settings directory, and autostart entry.",
    "icon": [
      "../../desktop/assets/icons/icon.png",
      "../../desktop/assets/icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "tsp": false,
      "allowDowngrades": true,
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "SnailPiPet Tauri Preview",
        "installerIcon": "../../desktop/assets/icons/icon.ico"
      }
    }
  }
}
