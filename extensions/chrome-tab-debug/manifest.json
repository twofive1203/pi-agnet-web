{
  "manifest_version": 3,
  "name": "Snail Pi Tab Debug",
  "version": "0.1.4",
  "description": "Temporarily bind selected Chrome tabs to a local Snail Pi session for restricted DOM debugging.",
  "action": {
    "default_title": "Snail Pi",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "debugger",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-ancestors 'none';"
  },
  "incognito": "not_allowed",
  "minimum_chrome_version": "116"
}
